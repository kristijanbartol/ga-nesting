{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run geometry",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_geometry.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Run nesting",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_nesting.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Run phase utils",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_phase_utils.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Run global align",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_global_align.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Generate panel2 (paper)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/paper/figures/gen_panel2_mesh.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Generate panel3 (paper)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/paper/figures/gen_panel3_layout.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Run GA",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_ga.py",
            "args": [
                "--garment", "onesie_sleeves",
                "--wallpaper", "grid",
                "--pop", "200",
                "--gens", "20",
                "--num_bodies", "50",
                "--seed", "0",
                "--w1", "1.0",
                "--w2", "10.0",
                "--w4", "0.0"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Simulate",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/geometry/simulation.py",
            "args": [
                "--garment", "lower",
                "--wallpaper", "stripes",
                "--pop", "10",
                "--gens", "1",
                "--num_bodies", "1",
                "--seed", "0",
                "--w1", "1.0",
                "--w2", "10.0",
                "--w4", "0.0"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Run experiments",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_experiments.py",
            "args": [
                "--garment", "onesie_sleeves",
                "--wallpaper", "stripes",
                "--num_bodies", "5", "10", "25", "50", "100",
                "--runs", "20",
                "--pop", "100",
                "--gens", "20",
                "--w1", "1.0",
                "--w2", "10.0",
                "--p_kappa", "0.15",
                "--delta_lo", "0.1",
                "--delta_hi", "0.9"
                // Auto-resumes on re-run — no --resume flag needed.
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Baseline 0",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_baseline_b0.py",
            "args": [
                "--simulate",
                "--garment-type", "onesie_sleeves",
                "--num-bodies", "50",
                "--wallpaper", "grid"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Baseline 1",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_baseline_b1.py",
            "args": [
                "--simulate",
                "--garment-type", "onesie_sleeves",
                "--num-bodies", "50",
                "--wallpaper", "grid"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Baseline 2",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_baseline_b2.py",
            "args": [
                "--simulate",
                "--garment-type", "onesie_sleeves",
                "--num-bodies", "50",
                "--wallpaper", "grid"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Visualize Simulation",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/visualize_simulation.py",
            "args": [
                "--garment", "lower",
                "--baseline", "b0",
                "--wallpaper", "grid",
                "--period", "50.0"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Debug",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/debug_landmarks.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Plot wallpaper figure (paper)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/plot_wallpaper_figure.py",
            "args": [
                "--garment", "upper"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Plot convergence (paper)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/plot_convergence.py",
            "args": [
                "--num_bodies", "5", "10", "25", "50", "100",
                "--target_seeds", "20"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Show wallpaper groups 3D (polyscope)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/show_wallpaper_3d.py",
            "args": [
                "--garment", "upper"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Debug pytest (all tests)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-s",
                "tests"
            ],
            "justMyCode": false,
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}