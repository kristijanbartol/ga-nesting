{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run geometry",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_geometry.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Run nesting",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_nesting.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Run phase utils",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_phase_utils.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Run global align",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_global_align.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Run GA",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_ga.py",
            "args": [
                "--garment", "upper",
                "--wallpaper", "pg",
                "--pop", "10",
                "--gens", "1",
                "--seed", "0",
                "--w1", "1.0",
                "--w2", "10.0"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Baseline 0",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_baseline_b0.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Baseline 1",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_baseline_b1.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Visualize Simulation",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/visualize_simulation.py",
            "args": [
                "--wallpaper", "p4m",
                "--period", "50.0"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Debug",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/debug_landmarks.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Debug pytest (all tests)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-s",
                "tests"
            ],
            "justMyCode": false,
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}