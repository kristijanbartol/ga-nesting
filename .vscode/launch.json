{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run geometry",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_geometry.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Run nesting",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_nesting.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Run phase utils",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_phase_utils.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Run global align",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_global_align.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Generate panel2 (paper)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/paper/figures/gen_panel2_mesh.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Generate panel3 (paper)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/paper/figures/gen_panel3_layout.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Run GA",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_ga.py",
            "args": [
                "--garment", "lower",
                "--wallpaper", "stripes",
                "--pop", "10",
                "--gens", "1",
                "--num_bodies", "1",
                "--seed", "0",
                "--w1", "1.0",
                "--w2", "10.0",
                "--w4", "0.0"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Simulate",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/geometry/simulation.py",
            "args": [
                "--garment", "lower",
                "--wallpaper", "stripes",
                "--pop", "10",
                "--gens", "1",
                "--num_bodies", "1",
                "--seed", "0",
                "--w1", "1.0",
                "--w2", "10.0",
                "--w4", "0.0"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Run experiments",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_experiments.py",
            "args": [
                "--garment", "lower",
                "--wallpaper", "stripes",
                "--num_bodies", "10",
                "--runs", "20",
                "--pop", "50",
                "--gens", "10",
                "--w1", "1.0",
                "--w2", "10.0"
                // To resume: add "--resume", "results/experiments/upper/<timestamp>"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Baseline 0",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_baseline_b0.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Baseline 2",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_baseline_b2.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Baseline 1",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_baseline_b1.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Visualize Simulation",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/visualize_simulation.py",
            "args": [
                "--garment", "lower",
                "--wallpaper", "stripes",
                "--period", "50.0"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Debug",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/debug_landmarks.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/potpourri3d/src"
            },
            "console": "integratedTerminal"
        },

        {
            "name": "Debug pytest (all tests)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-s",
                "tests"
            ],
            "justMyCode": false,
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}